rules_version = '2';

// Client SDK access is deliberately narrow. Sensitive writes (application
// creation, workflow actions, document metadata, and audits) go through the
// SvelteKit server, where Firebase Admin verifies the session and applies the
// workflow/department checks. Firebase Admin is not constrained by these
// rules, so this does not weaken the server-side authorization boundary.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // These are Firebase custom claims, issued only by trusted Admin tooling.
    // Browser-supplied Firestore fields are never used as a role source.
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isCitizen() {
      return signedIn() && request.auth.token.role == 'citizen';
    }

    function isDepartmentUser() {
      return signedIn() && request.auth.token.role == 'department_user';
    }

    function isOperator() {
      return signedIn() && request.auth.token.role == 'operator';
    }

    function canReadApplication(application) {
      return isAdmin()
        || (isCitizen() && application.citizenId == request.auth.uid)
        || (isDepartmentUser()
          && request.auth.token.departmentId == application.departmentId)
        || (isOperator() && application.assistedByOperatorId == request.auth.uid);
    }

    function applicationExists(applicationId) {
      return exists(/databases/$(database)/documents/applications/$(applicationId));
    }

    function canReadApplicationById(applicationId) {
      return applicationExists(applicationId)
        && canReadApplication(
          get(/databases/$(database)/documents/applications/$(applicationId)).data
        );
    }

    function canReadDocument(document) {
      return isAdmin()
        || (document.applicationId == null
          && isCitizen()
          && document.citizenId == request.auth.uid)
        || (document.applicationId != null
          && canReadApplicationById(document.applicationId));
    }

    function safeOwnProfileUpdate() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'phone',
          'preferredLanguage',
          'photoURL',
          'updatedAt'
        ]);
    }

    function safeNotificationReadUpdate() {
      return request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead',
          'readAt'
        ]);
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      // Profiles are created by verified server sessions. A user may only
      // update presentation/preferences and can never grant a role or move
      // themselves to another department.
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == userId && safeOwnProfileUpdate();
      allow delete: if false;
    }

    match /departments/{departmentId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if false;
    }

    match /services/{serviceId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if false;
    }

    match /workflows/{workflowId} {
      // Workflow definitions are internal processing configuration. Citizens
      // receive only permitted actions through the server-rendered API.
      allow read: if isAdmin() || isDepartmentUser() || isOperator();
      allow write: if false;
    }

    match /applications/{applicationId} {
      allow read: if canReadApplication(resource.data);
      // All application writes are server-authorized to keep catalog-derived
      // department/workflow IDs, tracking IDs, and transitions trustworthy.
      allow create, update, delete: if false;

      match /statusHistory/{historyId} {
        allow read: if canReadApplicationById(applicationId);
        // Append-only history is written atomically with a server-authorized
        // transition and is never mutable from the browser.
        allow create, update, delete: if false;
      }
    }

    match /documents/{documentId} {
      allow read: if canReadDocument(resource.data);
      // Metadata is coupled to Storage uploads and document review on the
      // server, so clients cannot spoof a path, review result, or ownership.
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.recipientId == request.auth.uid);
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && safeNotificationReadUpdate();
    }

    match /auditLogs/{auditLogId} {
      allow read, write: if false;
    }

    match /systemCounters/{counterId} {
      allow read, write: if false;
    }

    // A trusted Firebase custom-claim admin may perform administrative SDK
    // tasks through the client. All non-admin client access remains governed
    // by the narrower matches above. The SvelteKit server's Admin SDK is
    // independently authorized by its service account.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
