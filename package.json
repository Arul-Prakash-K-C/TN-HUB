{
	"name": "tn-hub",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/patch-vercel-nft-readlink.mjs && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"seed:demo": "node scripts/seed-demo.mjs",
		"seed:demo-auth": "node scripts/seed-demo-auth.mjs",
		"deploy:firebase-rules": "node scripts/deploy-firebase-rules.mjs",
		"verify:phase2": "node scripts/verify-phase2.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@lucide/svelte": "^1.33.0",
		"firebase": "^12.18.0",
		"firebase-admin": "^13.0.0"
	}
}
